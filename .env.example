# Copy this file to .env and paste your key.
# Get a free key at https://aistudio.google.com/apikey
# Leave it empty to run in fallback mode (no LLM, still works).
GEMINI_API_KEY=

# Optional staff passcode. Set it before putting the app online: everyone
# then needs it to open the app. Leave empty on your own computer.
STAFF_PASSCODE=
