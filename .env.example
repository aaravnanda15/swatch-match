# Copy this file to .env and paste your key.
# Get a free key at https://aistudio.google.com/apikey
# Leave it empty to run in fallback mode (no LLM, still works).
GEMINI_API_KEY=


# Optional: WhatsApp Business Cloud API (README, "Connect WhatsApp").
# Leave empty and the Inbox tab stays hidden.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# 1 = print replies in the server log instead of sending them (testing)
WHATSAPP_DRY_RUN=

# 1 = demo mode for presentations (README, "Demo mode"): simulated buyers,
# buyer chat, sample week in Insights. Set it to empty for a real shop.
DEMO_MODE=
